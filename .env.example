# Copy to .env.local and fill in. Never commit real values.
# All variables are optional in the foundation milestone: the app runs without them.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (AI-assisted extraction). Server-only.
ANTHROPIC_API_KEY=
# Optional override of the extraction model.
ANTHROPIC_MODEL=
