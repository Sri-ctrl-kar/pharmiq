# Copy to .env.local and fill in. Never commit real values.
# Every variable is optional for local development: with no Supabase variables the app
# uses LOCAL DEMONSTRATION storage (a JSON file — not a secure production database).

# --- Supabase (persistent production storage) -------------------------------------
# Set ALL THREE to store reports in Supabase. Setting only some of them disables
# report submission (fails closed) rather than silently using demo storage.
# Project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to call the submit_report database function. Never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local demonstration storage ---------------------------------------------------
# Directory for the demo JSON store when Supabase is not configured. Default: ./.data
DEMO_DATA_DIR=

# --- Reviewer access (demo only) ----------------------------------------------------
# With LOCAL DEMO storage, set both to allow a shared-code demo sign-in at
# /reviewer/sign-in. This is a single shared code, not individual accounts: use it for
# demonstrations with synthetic data only — it is not individual authentication. Ignored
# when Supabase storage is configured (reviewers then sign in with Supabase Auth).
# Without these, /reviewer stays locked. At least 12 characters; use a random value.
# Changing it signs every demo reviewer out.
REVIEWER_DEMO_ACCESS_CODE=
# At least 32 random characters; signs the reviewer session cookie. Server-only.
# e.g. `openssl rand -base64 48`. Changing it signs every reviewer out.
REVIEWER_SESSION_SECRET=

# --- Claude API: optional AI-assisted extraction. Server-only. ----------------------
# Without a key the form works manually and /api/extract returns 503 not_configured.
# Only the (minimised) description is sent. Use synthetic descriptions for demos.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Deployment ----------------------------------------------------------------------
# For multi-instance or self-hosted deployments, a stable key so Server Action
# references stay valid across instances (see Next.js self-hosting docs).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
